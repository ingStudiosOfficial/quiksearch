{
    "id": "dev.ingstudios.quiksearch",

    "runtime": "org.kde.Platform",

    "runtime-version": "6.7",

    "sdk": "org.kde.Sdk",

    "base": "io.qt.PySide.BaseApp",

    "base-version": "6.7",

    "command": "quiksearch",
    "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio"
    ],
    "modules": [
        {
            "name": "quiksearch",
            "buildsystem" : "simple",
            "build-commands" : [

                "pip3 install --no-build-isolation --prefix=/app ."

            ],
            "sources": [
                {
                    "type": "archive",

                    "path": "dist/quiksearch-0.1.tar.gz"

                }
            ]
        }
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ]
}
